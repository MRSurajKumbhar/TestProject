#!/bin/bash

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "        🔍 Pre-Push Impact Analysis"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

# --- PRE-FLIGHT CHECK ---
if ! xcrun --find xcodebuild &>/dev/null; then
    echo "❌ Xcode not found."
    echo "   Please install Xcode from the App Store."
    echo ""
    exit 1
fi

if ! xcrun xcodebuild -version &>/dev/null; then
    echo "❌ Xcode found but not responding."
    echo "   Run: sudo xcode-select -s /Applications/Xcode.app/Contents/Developer"
    echo ""
    exit 1
fi

# --- CONFIGURATION ---
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)

XCODEPROJ_PATH=$(find "$REPO_ROOT" -maxdepth 3 -name "*.xcodeproj" | head -1)
if [ -z "$XCODEPROJ_PATH" ]; then
    echo "❌ Could not find .xcodeproj in the repo."
    echo ""
    exit 1
fi

PROJECT_NAME=$(basename "$XCODEPROJ_PATH" | sed 's/\.xcodeproj//')
if [ -z "$PROJECT_NAME" ]; then
    echo "❌ Could not detect project name."
    echo ""
    exit 1
fi

TEST_TARGET="${PROJECT_NAME}Tests"
DEVELOP_BRANCH="develop"
DERIVED_DATA_DIR="$HOME/Library/Developer/Xcode/DerivedData"
DERIVED_DATA_PATH=$(ls -dt "$DERIVED_DATA_DIR/${PROJECT_NAME}-"* 2>/dev/null | head -1)
RESULT_BUNDLE="$DERIVED_DATA_PATH/Logs/Test/PrePush.xcresult"

echo "📦 Project  : $PROJECT_NAME"
echo "📁 Location : $XCODEPROJ_PATH"
echo "🎯 Target   : $TEST_TARGET"
echo "🌿 Branch   : $DEVELOP_BRANCH"
echo ""

# --- STEP 1: Find Index Store ---
echo "📂 Locating compiler index..."
DATA_STORE=$(ls -dt "$DERIVED_DATA_DIR/${PROJECT_NAME}-"*/Index.noindex/DataStore 2>/dev/null | head -1)

if [ -z "$DATA_STORE" ]; then
    echo ""
    echo "❌ Index Store not found."
    echo "   Please build the project in Xcode first → Cmd + B"
    echo ""
    exit 1
fi
echo "   ✅ Found: $DATA_STORE"
echo ""

# --- STEP 2: Get changed Swift source files ---
echo "📄 Finding changed Swift files vs $DEVELOP_BRANCH..."
CHANGED_FILES=$({ git diff "$DEVELOP_BRANCH" --name-only; git diff --cached --name-only; } \
    | grep "\.swift$" \
    | grep -vE "Tests|Spec" \
    | sort -u)

if [ -z "$CHANGED_FILES" ]; then
    echo "   ✅ No source files changed. Nothing to analyse."
    echo ""
    exit 0
fi

echo "   Changed files:"
while IFS= read -r FILE; do
    echo "   → $FILE"
done <<< "$CHANGED_FILES"
echo ""

# --- STEP 3: Dump raw index ONCE ---
echo "⏳ Loading compiler index..."
INDEX_DUMP=$(find "$DATA_STORE" -type f | xargs strings 2>/dev/null)

if [ -z "$INDEX_DUMP" ]; then
    echo ""
    echo "❌ Failed to read compiler index."
    echo "   Try rebuilding in Xcode → Cmd + B"
    echo ""
    exit 1
fi
echo "   ✅ Index loaded"
echo ""

# --- STEP 4: Analyze each changed file ---
echo "🔬 Analysing symbol references..."
echo ""

IMPACTED_TESTS=()

while IFS= read -r FILE; do
    [ -z "$FILE" ] && continue
    echo "   📄 $FILE"

    # FIX: Accept both uppercase AND lowercase first letter
    # Swift convention is uppercase but we support lowercase too (e.g. testFile2)
    SYMBOL_NAMES=$(grep -E "^(class|struct|enum|protocol|actor) [A-Za-z]" "$REPO_ROOT/$FILE" 2>/dev/null \
        | awk '{print $2}' \
        | sed 's/[:(<{].*//' \
        | sort -u)

    if [ -z "$SYMBOL_NAMES" ]; then
        SYMBOL_NAMES=$(grep -E "^(class|struct|enum|protocol|actor) [A-Za-z]" "$FILE" 2>/dev/null \
            | awk '{print $2}' \
            | sed 's/[:(<{].*//' \
            | sort -u)
    fi

    if [ -z "$SYMBOL_NAMES" ]; then
        echo "      ⚪ No public symbols found in this file"
        continue
    fi

    echo "      Symbols found:"
    while IFS= read -r SYMBOL; do
        echo "      → $SYMBOL"
    done <<< "$SYMBOL_NAMES"

    while IFS= read -r SYMBOL; do
        [ -z "$SYMBOL" ] && continue

        MATCHING_TESTS=$(echo "$INDEX_DUMP" \
            | grep -F "$SYMBOL" \
            | grep -oE "[A-Za-z]+Tests" \
            | grep -E "^${SYMBOL}Tests$" \
            | sort -u)

        if [ -z "$MATCHING_TESTS" ]; then
            echo "      ⚪ No test references found for $SYMBOL"
            continue
        fi

        while IFS= read -r TEST_NAME; do
            [ -z "$TEST_NAME" ] && continue
            IMPACTED_TESTS+=("$TEST_NAME")
            echo "      ✅ Impacted → $TEST_NAME"
        done <<< "$MATCHING_TESTS"

    done <<< "$SYMBOL_NAMES"

done <<< "$CHANGED_FILES"
echo ""

# --- STEP 5: Deduplicate ---
UNIQUE_TESTS=($(printf "%s\n" "${IMPACTED_TESTS[@]}" | sort -u))

# --- STEP 6: Auto-Run Impacted Tests ---
if [ ${#UNIQUE_TESTS[@]} -eq 0 ]; then
    echo "⚠️  No direct test references found for your changes."
    echo "   Skipping test run."
    echo ""
else
    SIM_NAME=$(xcrun simctl list devices available \
        | grep -E "iPhone [0-9]+" \
        | grep -v "unavailable" \
        | tail -1 \
        | sed 's/^[[:space:]]*//' \
        | sed 's/ (.*//')
    [ -z "$SIM_NAME" ] && SIM_NAME="iPhone 15"

    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "🚩 IMPACTED TESTS DETECTED:"
    echo ""
    TEST_FLAGS=""
    for T in "${UNIQUE_TESTS[@]}"; do
        echo "   - $T"
        TEST_FLAGS+="-only-testing:${TEST_TARGET}/${T} "
    done
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "🚀 Auto-running impacted tests..."
    echo "   Project   : $XCODEPROJ_PATH"
    echo "   Simulator : $SIM_NAME"
    echo ""

    rm -rf "$RESULT_BUNDLE"
    mkdir -p "$DERIVED_DATA_PATH/Logs/Test"

    xcrun xcodebuild test \
        -project "$XCODEPROJ_PATH" \
        -scheme "$PROJECT_NAME" \
        -destination "platform=iOS Simulator,name=$SIM_NAME" \
        -enableCodeCoverage YES \
        -resultBundlePath "$RESULT_BUNDLE" \
        $TEST_FLAGS \
        2>&1 | grep -E "Test (passed|failed|started)|error:|FAILED|PASSED|Build succeeded|Build FAILED"

    TEST_EXIT_CODE=${PIPESTATUS[0]}

    echo ""
    if [ $TEST_EXIT_CODE -ne 0 ]; then
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo "❌ TESTS FAILED — Push blocked."
        echo "   Fix the failing tests before pushing."
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo ""
        exit 1
    else
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo "✅ ALL TESTS PASSED — Proceeding with push."
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo ""
    fi
fi

# --- STEP 7: DELTA COVERAGE PHASE ---
echo "📊 Calculating Delta Coverage for Changed Lines..."
echo ""

if [ ! -d "$RESULT_BUNDLE" ]; then
    echo "⚠️  No .xcresult bundle found."
    echo "   Coverage will appear on your next push after tests run."
    echo ""
else
    echo "   ✅ Using: $RESULT_BUNDLE"
    echo ""

    echo "   ⏳ Loading coverage archive..."
    COVERAGE_ARCHIVE=$(xcrun xccov view --archive "$RESULT_BUNDLE" 2>/dev/null)

    if [ -z "$COVERAGE_ARCHIVE" ]; then
        echo "   ❌ Failed to load coverage archive."
        echo ""
    else
        echo "   ✅ Coverage archive loaded"
        echo ""

        TOTAL_CHANGED_LINES=0
        COVERED_CHANGED_LINES=0

        # Per-file coverage tracking
        declare -a FILE_NAMES=()
        declare -a FILE_TOTAL=()
        declare -a FILE_COVERED=()
        FILE_INDEX=0

        while IFS= read -r FILE; do
            [ -z "$FILE" ] && continue
            echo "   📄 $(basename $FILE)"

            CHANGED_LINE_NUMBERS=$(git diff "$DEVELOP_BRANCH" -U0 "$FILE" \
                | grep "^@@" \
                | awk '{
                    for (i = 1; i <= NF; i++) {
                        if ($i ~ /^\+[0-9]/) {
                            val = substr($i, 2)
                            n = split(val, parts, ",")
                            start = int(parts[1])
                            count = (n > 1) ? int(parts[2]) : 1
                            if (count == 0) next
                            for (j = 0; j < count; j++) {
                                print start + j
                            }
                        }
                    }
                }')

            if [ -z "$CHANGED_LINE_NUMBERS" ]; then
                echo "      ⚪ No changed lines found"
                continue
            fi

            LINE_COUNT=$(echo "$CHANGED_LINE_NUMBERS" | wc -l | tr -d ' ')
            echo "      Changed lines : $LINE_COUNT"

            ABSOLUTE_FILE="$REPO_ROOT/$FILE"

            # Extract per-line coverage for this file from the archive
            FILE_LINE_COVERAGE=$(echo "$COVERAGE_ARCHIVE" | python3 -c "
import sys

target_file = '$ABSOLUTE_FILE'
lines_coverage = {}
inside_file = False

for raw_line in sys.stdin:
    line = raw_line.rstrip()
    if line.endswith(':') and not line.startswith(' ') and '.swift' in line:
        inside_file = (line.rstrip(':') == target_file)
        continue
    if inside_file:
        stripped = line.strip()
        if not stripped:
            continue
        parts = stripped.split(':', 1)
        if len(parts) == 2:
            try:
                lineno = int(parts[0].strip())
                count_str = parts[1].strip()
                if count_str == '*':
                    continue
                count = int(count_str)
                lines_coverage[lineno] = count
            except ValueError:
                continue

for k, v in lines_coverage.items():
    print(f'{k}:{v}')
" 2>/dev/null)

            if [ -z "$FILE_LINE_COVERAGE" ]; then
                echo "      ⚪ No coverage data found for this file"
                continue
            fi

            # Count covered vs total for this file
            FILE_COVERED_COUNT=0
            FILE_TOTAL_COUNT=0

            for LINE in $CHANGED_LINE_NUMBERS; do
                ((TOTAL_CHANGED_LINES++))
                ((FILE_TOTAL_COUNT++))

                EXEC_COUNT=$(echo "$FILE_LINE_COVERAGE" \
                    | grep -E "^${LINE}:" \
                    | cut -d: -f2)
                EXEC_COUNT=${EXEC_COUNT:-0}

                if [[ "$EXEC_COUNT" -gt 0 ]]; then
                    ((COVERED_CHANGED_LINES++))
                    ((FILE_COVERED_COUNT++))
                fi
            done

            # Store per-file result
            FILE_NAMES[$FILE_INDEX]="$(basename $FILE)"
            FILE_TOTAL[$FILE_INDEX]=$FILE_TOTAL_COUNT
            FILE_COVERED[$FILE_INDEX]=$FILE_COVERED_COUNT
            ((FILE_INDEX++))

            # Per-file coverage summary
            FILE_UNCOVERED=$((FILE_TOTAL_COUNT - FILE_COVERED_COUNT))
            if [ $FILE_TOTAL_COUNT -gt 0 ]; then
                FILE_PCT=$(awk "BEGIN {printf \"%.2f\", ($FILE_COVERED_COUNT/$FILE_TOTAL_COUNT)*100}")
                echo "      ✅ Covered    : $FILE_COVERED_COUNT"
                echo "      ❌ Uncovered  : $FILE_UNCOVERED"
                echo "      📊 Coverage   : $FILE_PCT%"
            fi

        done <<< "$CHANGED_FILES"

        # --- Per-file summary table ---
        if [ $FILE_INDEX -gt 0 ]; then
            echo ""
            echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
            echo "📋 PER-FILE COVERAGE BREAKDOWN"
            echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
            for ((i=0; i<FILE_INDEX; i++)); do
                F_NAME="${FILE_NAMES[$i]}"
                F_TOTAL="${FILE_TOTAL[$i]}"
                F_COV="${FILE_COVERED[$i]}"
                F_UNCOV=$((F_TOTAL - F_COV))
                if [ $F_TOTAL -gt 0 ]; then
                    F_PCT=$(awk "BEGIN {printf \"%.2f\", ($F_COV/$F_TOTAL)*100}")
                    echo "   📄 $F_NAME"
                    echo "      Lines: $F_TOTAL | ✅ $F_COV | ❌ $F_UNCOV | 📊 $F_PCT%"
                fi
            done
        fi

        # --- Overall delta coverage ---
        if [ "$TOTAL_CHANGED_LINES" -gt 0 ]; then
            PERCENTAGE=$(awk "BEGIN {printf \"%.2f\", ($COVERED_CHANGED_LINES/$TOTAL_CHANGED_LINES)*100}")
            UNCOVERED=$((TOTAL_CHANGED_LINES - COVERED_CHANGED_LINES))
            echo ""
            echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
            echo "📈 OVERALL DELTA COVERAGE REPORT"
            echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
            echo ""
            echo "   Total changed lines   : $TOTAL_CHANGED_LINES"
            echo "   ✅ Covered            : $COVERED_CHANGED_LINES"
            echo "   ❌ Uncovered          : $UNCOVERED"
            echo "   📊 Coverage           : $PERCENTAGE%"
            echo ""
            echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
            echo ""
        else
            echo ""
            echo "ℹ️  No executable changed lines found to calculate coverage."
            echo ""
        fi
    fi
fi

exit 0
#!/bin/bash

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "        🔍 Pre-Push Impact Analysis"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

# --- PRE-FLIGHT CHECK ---
if ! xcrun --find xcodebuild &>/dev/null; then
    echo "❌ Xcode not found."
    echo "   Please install Xcode from the App Store."
    echo ""
    exit 1
fi

if ! xcrun xcodebuild -version &>/dev/null; then
    echo "❌ Xcode found but not responding."
    echo "   Run: sudo xcode-select -s /Applications/Xcode.app/Contents/Developer"
    echo ""
    exit 1
fi

# --- CONFIGURATION ---
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
PROJECT_NAME=$(find "$REPO_ROOT" -maxdepth 3 -name "*.xcodeproj" \
    | head -1 \
    | xargs basename 2>/dev/null \
    | sed 's/\.xcodeproj//')

if [ -z "$PROJECT_NAME" ]; then
    echo "❌ Could not detect project name."
    echo "   Make sure a .xcodeproj file exists in the repo."
    echo ""
    exit 1
fi

TEST_TARGET="${PROJECT_NAME}Tests"
DEVELOP_BRANCH="develop"
DERIVED_DATA_DIR="$HOME/Library/Developer/Xcode/DerivedData"

echo "📦 Project  : $PROJECT_NAME"
echo "🎯 Target   : $TEST_TARGET"
echo "🌿 Branch   : $DEVELOP_BRANCH"
echo ""

# --- STEP 1: Find Index Store ---
echo "📂 Locating compiler index..."
DATA_STORE=$(ls -dt "$DERIVED_DATA_DIR/${PROJECT_NAME}-"*/Index.noindex/DataStore 2>/dev/null | head -1)

if [ -z "$DATA_STORE" ]; then
    echo ""
    echo "❌ Index Store not found."
    echo "   Please build the project in Xcode first → Cmd + B"
    echo ""
    exit 1
fi
echo "   ✅ Found: $DATA_STORE"
echo ""

# --- STEP 2: Get changed Swift source files ---
echo "📄 Finding changed Swift files vs $DEVELOP_BRANCH..."
CHANGED_FILES=$({ git diff "$DEVELOP_BRANCH" --name-only; git diff --cached --name-only; } \
    | grep "\.swift$" \
    | grep -vE "Tests|Spec" \
    | sort -u)

if [ -z "$CHANGED_FILES" ]; then
    echo "   ✅ No source files changed. Nothing to analyse."
    echo ""
    exit 0
fi

echo "   Changed files:"
while IFS= read -r FILE; do
    echo "   → $FILE"
done <<< "$CHANGED_FILES"
echo ""

# --- STEP 3: Dump raw index ONCE ---
echo "⏳ Loading compiler index..."
INDEX_DUMP=$(find "$DATA_STORE" -type f \
    | xargs strings 2>/dev/null)

if [ -z "$INDEX_DUMP" ]; then
    echo ""
    echo "❌ Failed to read compiler index."
    echo "   Try rebuilding in Xcode → Cmd + B"
    echo ""
    exit 1
fi
echo "   ✅ Index loaded"
echo ""

# --- STEP 4: Analyze each changed file ---
echo "🔬 Analysing symbol references..."
echo ""

IMPACTED_TESTS=()

while IFS= read -r FILE; do
    [ -z "$FILE" ] && continue
    echo "   📄 $FILE"

    # Extract class/struct/enum/protocol names directly from the source file
    # This is reliable because we read the actual Swift source
    SYMBOL_NAMES=$(grep -E "^(class|struct|enum|protocol|actor) [A-Z]" "$REPO_ROOT/$FILE" 2>/dev/null \
        | awk '{print $2}' \
        | sed 's/[:(<{].*//' \
        | sort -u)

    if [ -z "$SYMBOL_NAMES" ]; then
        # Also try without REPO_ROOT prefix
        SYMBOL_NAMES=$(grep -E "^(class|struct|enum|protocol|actor) [A-Z]" "$FILE" 2>/dev/null \
            | awk '{print $2}' \
            | sed 's/[:(<{].*//' \
            | sort -u)
    fi

    if [ -z "$SYMBOL_NAMES" ]; then
        echo "      ⚪ No public symbols found in this file"
        continue
    fi

    echo "      Symbols found:"
    while IFS= read -r SYMBOL; do
        echo "      → $SYMBOL"
    done <<< "$SYMBOL_NAMES"

    while IFS= read -r SYMBOL; do
        [ -z "$SYMBOL" ] && continue

        # Search index for test files referencing this symbol
        # The index stores entries like: ContentViewModelTests...ContentViewModel
        # We look for lines containing both the symbol AND "Tests"
        MATCHING_TESTS=$(echo "$INDEX_DUMP" \
            | grep -F "$SYMBOL" \
            | grep "Tests" \
            | grep -oE "[A-Z][a-zA-Z]+Tests" \
            | sort -u)

        while IFS= read -r TEST_NAME; do
            [ -z "$TEST_NAME" ] && continue
            IMPACTED_TESTS+=("$TEST_NAME")
            echo "      ✅ Impacted → $TEST_NAME"
        done <<< "$MATCHING_TESTS"

    done <<< "$SYMBOL_NAMES"

done <<< "$CHANGED_FILES"
echo ""

# --- STEP 5: Deduplicate ---
UNIQUE_TESTS=($(printf "%s\n" "${IMPACTED_TESTS[@]}" | sort -u))

# --- STEP 6: Report & Dynamic Simulator Selection ---
if [ ${#UNIQUE_TESTS[@]} -eq 0 ]; then
    echo "⚠️  No direct test references found for your changes."
    echo "   Consider running the full test suite to be safe."
    echo ""
else
    SIM_NAME=$(xcrun simctl list devices available \
        | grep -E "iPhone [0-9]+" \
        | grep -v "unavailable" \
        | tail -1 \
        | sed 's/^[[:space:]]*//' \
        | sed 's/ (.*//')
    [ -z "$SIM_NAME" ] && SIM_NAME="iPhone 15"

    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "🚩 IMPACTED TESTS DETECTED:"
    echo ""
    TEST_FLAGS=""
    for T in "${UNIQUE_TESTS[@]}"; do
        echo "   - $T"
        TEST_FLAGS+="-only-testing:${TEST_TARGET}/${T} "
    done
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "🚀 Run this command before pushing:"
    echo ""
    echo "xcodebuild test \\"
    echo "  -scheme $PROJECT_NAME \\"
    echo "  -destination 'platform=iOS Simulator,name=$SIM_NAME' \\"
    echo "  -enableCodeCoverage YES \\"
    echo "  $TEST_FLAGS"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
fi

# --- STEP 7: DELTA COVERAGE PHASE ---
echo "📊 Calculating Delta Coverage for Changed Lines..."
echo ""

RESULT_BUNDLE=$(ls -dt "$DERIVED_DATA_DIR/$PROJECT_NAME-"*/Logs/Test/*.xcresult 2>/dev/null | head -1)

if [ -z "$RESULT_BUNDLE" ]; then
    echo "⚠️  No .xcresult bundle found."
    echo "   Run the suggested xcodebuild command above with -enableCodeCoverage YES"
    echo "   then push again to see delta coverage."
    echo ""
else
    echo "   ✅ Using: $RESULT_BUNDLE"
    echo ""

    TOTAL_CHANGED_LINES=0
    COVERED_CHANGED_LINES=0

    while IFS= read -r FILE; do
        [ -z "$FILE" ] && continue
        echo "   📄 Checking coverage: $FILE"

        # Pure awk — avoids macOS BSD sed trap
        # Expands hunk headers into every individual changed line number
        CHANGED_LINE_NUMBERS=$(git diff "$DEVELOP_BRANCH" -U0 "$FILE" \
            | awk '
                /^@@/ {
                    match($0, /\+([0-9]+)(,([0-9]+))?/, arr)
                    start = arr[1]
                    count = (arr[3] != "") ? arr[3] : 1
                    for (i = 0; i < count; i++) print start + i
                }
            ')

        if [ -z "$CHANGED_LINE_NUMBERS" ]; then
            echo "      ⚪ No changed lines found"
            continue
        fi

        FILE_COVERAGE_JSON=$(xcrun xccov view \
            --file "$FILE" \
            --json "$RESULT_BUNDLE" 2>/dev/null)

        if [ -z "$FILE_COVERAGE_JSON" ]; then
            echo "      ⚪ No coverage data found for this file"
            continue
        fi

        for LINE in $CHANGED_LINE_NUMBERS; do
            ((TOTAL_CHANGED_LINES++))

            EXEC_COUNT=$(echo "$FILE_COVERAGE_JSON" | python3 -c "
import sys, json
try:
    data = json.load(sys.stdin)
    lines = data.get('lines', [])
    count = next((l.get('executionCount', 0) for l in lines if l.get('line') == $LINE), 0)
    print(count)
except:
    print(0)
" 2>/dev/null)

            if [[ "$EXEC_COUNT" -gt 0 ]]; then
                ((COVERED_CHANGED_LINES++))
            fi
        done

    done <<< "$CHANGED_FILES"

    if [ "$TOTAL_CHANGED_LINES" -gt 0 ]; then
        PERCENTAGE=$(awk "BEGIN {printf \"%.2f\", ($COVERED_CHANGED_LINES/$TOTAL_CHANGED_LINES)*100}")
        UNCOVERED=$((TOTAL_CHANGED_LINES - COVERED_CHANGED_LINES))
        echo ""
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo "📈 DELTA COVERAGE REPORT"
        echo ""
        echo "   Total changed lines   : $TOTAL_CHANGED_LINES"
        echo "   ✅ Covered            : $COVERED_CHANGED_LINES"
        echo "   ❌ Uncovered          : $UNCOVERED"
        echo "   📊 Coverage           : $PERCENTAGE%"
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo ""
    else
        echo ""
        echo "ℹ️  No executable changed lines found to calculate coverage."
        echo ""
    fi
fi

exit 0
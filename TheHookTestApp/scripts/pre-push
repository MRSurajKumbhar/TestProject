
#!/bin/bash

# --- PRE-FLIGHT CHECK ---
if ! xcrun swift-ide-test -help &>/dev/null; then
    echo "❌ swift-ide-test not available. Ensure Xcode Command Line Tools are installed."
    exit 1
fi

# --- CONFIGURATION ---
PROJECT_NAME="YourProjectName"
TEST_TARGET="${PROJECT_NAME}Tests"
DEVELOP_BRANCH="develop"
DERIVED_DATA_DIR="$HOME/Library/Developer/Xcode/DerivedData"

echo "🔍 Starting Compiler-Layer Impact Analysis..."

# 1. Find Index Store
DATA_STORE=$(ls -dt "$DERIVED_DATA_DIR/${PROJECT_NAME}-"*/Index.noindex/DataStore 2>/dev/null | head -1)
if [ -z "$DATA_STORE" ]; then
    echo "❌ Index Store not found. Build the project in Xcode first."
    exit 1
fi
echo "📂 Using DataStore: $DATA_STORE"

# 2. Get changed Swift source files (staged + unstaged, no test files)
CHANGED_FILES=$({ git diff "$DEVELOP_BRANCH" --name-only; git diff --cached --name-only; } \
    | grep "\.swift$" \
    | grep -vE "Tests|Spec" \
    | sort -u)

if [ -z "$CHANGED_FILES" ]; then
    echo "✅ No source files changed. Skipping."
    exit 0
fi

# 3. Dump index ONCE
echo "⏳ Loading index..."
INDEX_DUMP=$(xcrun swift-ide-test \
    -print-indexed-symbols \
    -index-store-path "$DATA_STORE" 2>/dev/null)

if [ -z "$INDEX_DUMP" ]; then
    echo "❌ Failed to read index. Try rebuilding in Xcode."
    exit 1
fi

IMPACTED_TESTS=()

# 4. Analyze each changed file (while+read handles spaces in paths)
while IFS= read -r FILE; do
    [ -z "$FILE" ] && continue
    echo "📄 Analyzing: $FILE"

    # Extract USRs for symbols defined in this file
    # Full Swift USR charset: s: prefix + alphanumeric, $, ., :, @
    USRS=$(grep -F "$FILE" <<< "$INDEX_DUMP" \
        | grep "def:" \
        | grep -oE "s:[a-zA-Z0-9_\$.:@]+" \
        | sort -u)

    while IFS= read -r USR; do
        [ -z "$USR" ] && continue

        # Find all .swift files referencing this USR
        REFS=$(grep -F "$USR" <<< "$INDEX_DUMP" \
            | grep "ref:" \
            | grep -oE "[^[:space:]]+\.swift")

        while IFS= read -r REF; do
            [ -z "$REF" ] && continue
            if [[ "$REF" == *"Tests.swift" ]] || \
               [[ "$REF" == *"Spec.swift" ]] || \
               [[ "$REF" == *"/Tests/"* ]]; then
                TEST_NAME=$(basename "$REF" .swift)
                IMPACTED_TESTS+=("$TEST_NAME")
            fi
        done <<< "$REFS"

    done <<< "$USRS"

done <<< "$CHANGED_FILES"

# 5. Deduplicate
UNIQUE_TESTS=($(printf "%s\n" "${IMPACTED_TESTS[@]}" | sort -u))

# 6. Report & Dynamic Simulator Selection
if [ ${#UNIQUE_TESTS[@]} -eq 0 ]; then
    echo "⚠️  No test references found for changed files."
else
    # Robustly pick latest available iPhone simulator
    SIM_NAME=$(xcrun simctl list devices available \
        | grep -E "iPhone [0-9]+" \
        | grep -v "unavailable" \
        | tail -1 \
        | sed 's/^[[:space:]]*//' \
        | sed 's/ (.*//')
    [ -z "$SIM_NAME" ] && SIM_NAME="iPhone 15"

    echo "------------------------------------------------"
    echo "🚩 IMPACTED TESTS DETECTED:"
    TEST_FLAGS=""
    for T in "${UNIQUE_TESTS[@]}"; do
        echo "  - $T"
        TEST_FLAGS+="-only-testing:${TEST_TARGET}/${T} "
    done
    echo "------------------------------------------------"
    echo "🚀 Run this before pushing (Coverage Enabled):"
    echo ""
    echo "xcodebuild test \\"
    echo "  -scheme $PROJECT_NAME \\"
    echo "  -destination 'platform=iOS Simulator,name=$SIM_NAME' \\"
    echo "  -enableCodeCoverage YES \\"
    echo "  $TEST_FLAGS"
    echo "------------------------------------------------"
fi

# --- 7. DELTA COVERAGE PHASE (Office Friendly / No JQ) ---
echo "📊 Calculating Coverage for Changed Lines..."

# Locate the .xcresult bundle
RESULT_BUNDLE=$(ls -dt "$DERIVED_DATA_DIR/$PROJECT_NAME-"*/Logs/Test/*.xcresult 2>/dev/null | head -1)

if [ -z "$RESULT_BUNDLE" ]; then
    echo "⚠️  No .xcresult found. Run tests with -enableCodeCoverage YES first."
else
    TOTAL_CHANGED_LINES=0
    COVERED_CHANGED_LINES=0

    while IFS= read -r FILE; do
        [ -z "$FILE" ] && continue

        # FIX: Pure awk solution — avoids macOS BSD sed \? trap entirely
        # Parses hunk headers like "+42,8" or "+42" (no comma = 1 line)
        # and expands them into every individual line number
        CHANGED_LINE_NUMBERS=$(git diff "$DEVELOP_BRANCH" -U0 "$FILE" \
            | awk '
                /^@@/ {
                    # Extract the "+start,count" part from the hunk header
                    match($0, /\+([0-9]+)(,([0-9]+))?/, arr)
                    start = arr[1]
                    # If no comma+count, it is a single line change
                    count = (arr[3] != "") ? arr[3] : 1
                    # Expand: print each line number in the hunk
                    for (i = 0; i < count; i++) print start + i
                }
            ')

        if [ -z "$CHANGED_LINE_NUMBERS" ]; then continue; fi

        # Extract JSON coverage for the file
        FILE_COVERAGE_JSON=$(xcrun xccov view --file "$FILE" --json "$RESULT_BUNDLE" 2>/dev/null)

        if [ -z "$FILE_COVERAGE_JSON" ]; then continue; fi

        for LINE in $CHANGED_LINE_NUMBERS; do
            ((TOTAL_CHANGED_LINES++))

            # Use Python (Built-in) to parse the JSON
            EXEC_COUNT=$(echo "$FILE_COVERAGE_JSON" | python3 -c "
import sys, json
try:
    data = json.load(sys.stdin)
    lines = data.get('lines', [])
    count = next((l.get('executionCount', 0) for l in lines if l.get('line') == $LINE), 0)
    print(count)
except:
    print(0)
" 2>/dev/null)

            if [[ "$EXEC_COUNT" -gt 0 ]]; then
                ((COVERED_CHANGED_LINES++))
            fi
        done
    done <<< "$CHANGED_FILES"

    # Percentage calculation
    if [ "$TOTAL_CHANGED_LINES" -gt 0 ]; then
        PERCENTAGE=$(awk "BEGIN {printf \"%.2f\", ($COVERED_CHANGED_LINES/$TOTAL_CHANGED_LINES)*100}")
        echo "------------------------------------------------"
        echo "📈 DELTA COVERAGE: $PERCENTAGE%"
        echo "✅ Covered: $COVERED_CHANGED_LINES | ❌ Uncovered: $((TOTAL_CHANGED_LINES - COVERED_CHANGED_LINES))"
        echo "------------------------------------------------"
    else
        echo "ℹ️  No executable changed lines found to calculate coverage."
    fi
fi

exit 0